# Base variables (required)
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
POSTGRES_PASSWORD=
DB_AGENT_PASSWORD=
# Необязательно: прокси для доступа к LLM API. Пример локального прокси из Docker:
# LLM_HTTPS_PROXY=http://host.docker.internal:20809
LLM_HTTPS_PROXY=
NEWS_DB_PASSWORD=
NEWS_READER_PASSWORD=

# Optional variables
LLM_CLASSIFICATION_MODEL=google/gemma-4-26b-a4b-it
LLM_EXTRACTION_MODEL=qwen/qwen3.6-35b-a3b
LLM_ANALYSIS_MODEL=deepseek/deepseek-v4.1-flash
LLM_CHAT_MODEL=z-ai/glm-5.3-flash
LLM_REQUEST_TIMEOUT=120
LLM_RESEARCH_MODEL=deepseek/deepseek-v4.1-flash
POSTGRES_PORT=55432
DB_HOST=localhost
DB_PORT=55432
DB_NAME=alfa
NEWS_DB_PASSWORD=change-me-news-admin
NEWS_READER_PASSWORD=change-me-news-reader
NEWS_DB_PORT=5433
NEWS_SEARCH_MODE=lexical
NEWS_EMBEDDING_PROFILE=
COMPANY_DATABASE_URL=
COMPANY_EMBEDDING_PROFILE=
BANK_DATABASE_URL=
BANK_SEARCH_MODE=
BANK_EMBEDDING_PROFILE=
LLM_BRIEF_MODEL=google/gemma-4-26b-a4b-it

LINKS_WRITER_PASSWORD=
LINKS_SYNC_SECONDS=300
LLM_IMPORTANCE_MODEL=google/gemma-4-26b-a4b-it
STARTUP_DATA_ENABLED=true
