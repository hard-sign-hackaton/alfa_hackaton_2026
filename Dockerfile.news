FROM python:3.12-slim AS news
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt /tmp/news-requirements.txt
RUN pip install --index-url https://download.pytorch.org/whl/cpu 'torch>=2.4,<3'
RUN pip install -r /tmp/news-requirements.txt
# OCR dependencies may otherwise install a CUDA torchvision next to CPU torch.
RUN pip install --upgrade --index-url https://download.pytorch.org/whl/cpu 'torch>=2.4,<3' 'torchvision>=0.19,<1' \
    && python -c "import torch, torchvision; assert torch.version.cuda is None; torchvision.ops.nms(torch.zeros((0, 4)), torch.zeros(0), 0.5)" \
    && pip check
RUN groupadd --gid 10001 newspipeline \
    && useradd --uid 10001 --gid newspipeline --no-create-home newspipeline \
    && mkdir -p /runtime /models && chown newspipeline:newspipeline /runtime /models
COPY app /app/app
COPY migrations /app/migrations
COPY news_pipeline /app/news_pipeline
COPY alembic.ini /app/alembic.ini
COPY tests/news /app/tests/news
COPY tests/companies /app/tests/companies
COPY tests/analytics /app/tests/analytics
COPY research/bank/manifest.json /app/research/bank/manifest.json
COPY docs/companies /app/docs/companies
COPY research/news/kom_article.html research/news/ved_article.html research/news/inter_article.html /app/research/news/
COPY research/contracts/t01/ai-news-event.schema.json /app/research/contracts/t01/
COPY research/contracts/news-ingestion.schema.json /app/research/contracts/
COPY research/ai/results/company_profile.schema.json /app/research/ai/results/
ENV NEWS_RUNTIME_DIR=/runtime COMPANIES_RUNTIME_DIR=/runtime ANALYTICS_RUNTIME_DIR=/runtime HF_HOME=/models
USER newspipeline
ENTRYPOINT ["python", "-m", "app.modules.news"]
CMD ["--help"]

FROM news AS agent
USER root
COPY research/ai/requirements.txt /tmp/ai-requirements.txt
RUN pip install -r /tmp/ai-requirements.txt
COPY --chown=newspipeline:newspipeline research/ai /app/research/ai
COPY --chown=newspipeline:newspipeline research/contracts /app/research/contracts
ENV PYTHONPATH=/app
USER newspipeline
WORKDIR /app/research/ai
ENTRYPOINT ["python", "analyze_pair.py"]
CMD []

FROM news AS default-news
