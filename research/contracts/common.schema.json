{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "common",
  "description": "U01 v0.1: черновой контракт для согласования командой.",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "company_dataset",
            "news",
            "bank",
            "user",
            "demo"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "locator",
        "as_of"
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "conflicting"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "status",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "news",
            "bank",
            "company",
            "user"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "forecast_period": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "is_fictional": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "outdated"
          ]
        },
        "fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "locator"
            ]
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "publisher",
        "url",
        "locator",
        "published_at",
        "retrieved_at",
        "is_fictional",
        "availability",
        "fragments"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "fragment_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "fragment_id"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source_fact",
            "bank_position",
            "ai_inference",
            "user_data"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "evidence",
        "feature_ids",
        "assumptions",
        "limitations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "source_fact",
                  "bank_position"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            },
            "required": [
              "name",
              "value",
              "unit",
              "period",
              "provenance"
            ]
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_illustrative": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "unit",
        "period",
        "formula",
        "inputs",
        "assumptions",
        "limitations",
        "is_illustrative"
      ]
    },
    "trace_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result_summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "error"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "timestamp",
        "action",
        "tool",
        "input_ids",
        "output_ids",
        "result_summary",
        "status",
        "checks",
        "correction"
      ]
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "found",
            "not_found",
            "outdated",
            "conflicting",
            "unavailable"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "position",
        "interpretation",
        "source_ids",
        "note"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "found"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "$ref": "#/$defs/claim"
              },
              "source_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_found",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              },
              "interpretation": {
                "type": "null"
              },
              "source_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
