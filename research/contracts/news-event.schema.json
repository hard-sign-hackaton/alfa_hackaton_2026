{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "news-event",
  "description": "U01 v0.1: черновой контракт для согласования командой.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "original_title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_fictional": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/claim"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "original_title",
    "text",
    "summary",
    "published_at",
    "collected_at",
    "is_fictional",
    "sources",
    "facts",
    "limitations"
  ]
}
